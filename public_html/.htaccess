# Macrolab website - document root configuration.
#
# Only Apache reads this file. On TU Delft Plesk hosting PHP must therefore run
# as "FPM application served by Apache"; with "served by nginx" NOTHING here
# applies and routing breaks. In the fallback layout, where app/ sits inside the
# document root, app/ would then also become readable. Verify before go-live by
# requesting /login and /app/config.php - see README.md, step 7.

Options -Indexes -MultiViews

# "/" is a real directory, so the rewrite rules below leave it alone and
# Apache picks its index file. Name ours only: Plesk drops a default index.html
# into a new document root, and Apache would otherwise serve that instead of
# the hub.
DirectoryIndex index.php

# ---------------------------------------------------------------- routing ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve the application directories. With the document root set to
    # public_html they are outside it anyway; this rule covers the fallback
    # layout, where they sit inside it.
    RewriteRule ^(app|vendor|tests|docs|docker)(/|$) - [F,L]

    # Serve real files and directories as-is (assets).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a route.
    RewriteRule ^ index.php [L]
</IfModule>

# ------------------------------------------------------------ hygiene --------
# Dotfiles, backups and SQL dumps are never web content.
<FilesMatch "(^\.|\.(sql|log|md|ini|bak|swp|dist|example)$|~$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
</IfModule>

# Cache the vendored calendar assets; they are versioned by filename.
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(js|css|woff2?)$">
        ExpiresDefault "access plus 7 days"
    </FilesMatch>
</IfModule>
